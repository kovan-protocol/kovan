# Kovan console — testnet only. Copy to .env.local; never commit .env.local.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# Contract IDs default to ../deployments/testnet.json; override here if needed.
POOL_ID=
POLICY_ID=
VERIFIER_ID=
USDC_SAC_ID=

# Server-side agent signer (testnet). Human-generated with `stellar keys generate`.
# `stellar keys secret <name>` prints the S… secret. Never commit .env.local.
AGENT_SECRET=
# Pays fees for agent transactions (any funded testnet G account).
FEE_PAYER_SECRET=
