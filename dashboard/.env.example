# Kovan console — testnet only. Copy to .env.local; never commit .env.local.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# Contract IDs default to ../deployments/testnet.json; override here if needed.
POOL_ID=
POLICY_ID=
VERIFIER_ID=
USDC_SAC_ID=

# Optional: a single agent secret used when the agent key is not in the local keystore (.keys/agents.json).
# Human-generated with `stellar keys generate`; `stellar keys secret <name>` prints the S… secret.
AGENT_SECRET=
# Optional. Pays XLM fees for agent transactions; if unset, the console generates a fee payer and funds it from Friendbot (testnet).
FEE_PAYER_SECRET=

# Optional. Alternative manifest path (default ../deployments/testnet.json; re-read at runtime).
KOVAN_DEPLOYMENTS=
# Optional. Alternative keystore file for app-managed agent keys (default .keys/agents.json, mode 0600).
KOVAN_KEYSTORE=
