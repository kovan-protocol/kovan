{
  "name": "@kovan-protocol/sdk",
  "version": "0.1.0",
  "description": "Non-custodial TypeScript client for Kovan pools and agent accounts on Stellar",
  "license": "MIT",
  "homepage": "https://kovan-protocol.vercel.app/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovan-protocol/kovan.git",
    "directory": "sdk"
  },
  "bugs": { "url": "https://github.com/kovan-protocol/kovan/issues" },
  "keywords": ["stellar", "soroban", "agent", "payments", "typescript"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./experimental": { "types": "./dist/experimental.d.ts", "import": "./dist/experimental.js", "default": "./dist/experimental.js" }
  },
  "files": ["dist", "src", "README.md", "LICENSE", "examples"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "example:testnet": "node examples/testnet-lifecycle.mjs"
  },
  "peerDependencies": { "@stellar/stellar-sdk": "^16.4.1" },
  "dependencies": { "buffer": "^6.0.3" },
  "devDependencies": {
    "@stellar/stellar-sdk": "16.4.1",
    "@types/node": "^22.20.5",
    "typescript": "^5",
    "vitest": "5.0.5",
    "vite": "8.3.5"
  }
}
